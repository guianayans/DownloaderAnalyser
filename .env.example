# Raiz exibida na UI (/)
DOWNLOADER_ROOT_LABEL=/

# Caminho real no container (host montado em /host)
DOWNLOADER_ROOT=/host

# Histórico persistente: jobs, atalhos e layout da sidebar
# No host: corresponde ao caminho após /host (ex.: /host/pendriver/downloader_hist → /pendriver/downloader_hist)
DOWNLOADER_HIST_DIR=/host/pendriver/downloader_hist

# Porta interna do app
PORT=4020

# Obrigatório — senha de login (sem aspas)
DOWNLOADER_PASSWORD=troque-por-uma-senha-forte

# Obrigatório — segredo da sessão (openssl rand -hex 32)
DOWNLOADER_SESSION_SECRET=troque-por-um-segredo-longo-aleatorio

HF_XET_HIGH_PERFORMANCE=1
# Legado (ignorado pelo huggingface_hub recente): HF_HUB_ENABLE_HF_TRANSFER=1
# HF_TOKEN=

# --- Ollama (Downloader = cliente da API) ---
# OLLAMA_HOST: URL do serviço Ollama (outro container ou host)
OLLAMA_HOST=http://host.docker.internal:11434
# Ollama precisa enxergar os mesmos caminhos do host (importação de GGUF usa FROM no Modelfile).
# Ex: se o arquivo está em /pendriver/llamacpp/models/modelo.gguf no host,
# monte essa pasta no container Ollama e use OLLAMA_HOST_ROOT=/ no Downloader.
OLLAMA_HOST_ROOT=/

# Caminho da pasta Ollama *dentro* do container (bind mount típico: /pendriver/ollama → /root/.ollama).
# Com isso, GGUF em llamacpp/models são linkados em pendriver/ollama/gguf-import/ e importados como
# FROM /root/.ollama/gguf-import/arquivo.gguf — sem copiar o arquivo inteiro.
OLLAMA_CONTAINER_ROOT=/root/.ollama
OLLAMA_GGUF_STAGING_DIR=gguf-import

# ONDE O OLLAMA GRAVA os modelos baixados (aba Baixar modelo):
#   NÃO é controlado por estas variáveis do Downloader.
#   Configure no stack/container Ollama (app LocalLLM / Coolify), por exemplo:
#     volumes:
#       - /pendriver/ollama:/root/.ollama
#   Sem esse bind mount, os arquivos ficam só no volume Docker do Ollama.

# Pastas escaneadas na aba "Arquivos GGUF" (relativas a /host, separadas por vírgula)
# Downloads hf.co/… também gravam .gguf na primeira pasta llamacpp desta lista.
AI_GGUF_DIRS=pendriver/llamacpp/models,pendriver/ollama/models

# Só para o Downloader: "Abrir pasta" e detecção local (relativo, SEM barra inicial)
# Correto: pendriver/ollama/models   |   Errado: /pendriver/ollama
OLLAMA_MODELS_DIR=pendriver/ollama/models

OPEN_WEBUI_URL=https://openwebui.gvtserver.online
OLLAMA_PUBLIC_URL=https://ollama.gvtserver.online

# llama.cpp server (router mode) — mesma pasta que AI_GGUF_DIRS/llamacpp
# Na rede coolify use o nome do container (porta interna 8080):
LLAMAWEB_URL=http://llamacpp:8080
LLAMAWEB_PUBLIC_URL=https://llamacpp.gvtserver.online
# Para o Downloader enviar parâmetros na carga (ctx, ngl, etc.), o llamacpp precisa:
#   --models-allow-extra-args

# Monitor GPU (aba Uso GPU)
# GPU_TERMINAL_CMD=nvtop
# GPU_TERMINAL_MODE=container
